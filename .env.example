DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=changeit
DB_NAME=tenantforge

# First platform admin, created by `npm run seed:admin`. Use a real secret outside local dev.
BOOTSTRAP_ADMIN_EMAIL=admin@tenantforge.local
BOOTSTRAP_ADMIN_PASSWORD=changeit-12chars-min
BOOTSTRAP_ADMIN_NAME=Platform Admin

# Auth. JWT_SECRET signs access tokens; use a long random value, e.g.
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_IDLE_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
